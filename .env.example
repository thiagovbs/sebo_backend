# Banco local (SQLite). O diretório é criado automaticamente.
DATABASE_URL=sqlite:///./data/sebo.db

# Porta do backend FastAPI
PORT=8200

# Origem do frontend liberada no CORS (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# --- Acesso ao painel de admin (/admin) ---
# Senha do painel. Troque em produção.
ADMIN_PASSWORD=admin123
# Segredo que assina o token do admin. Gere um próprio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=dev-insecure-admin-secret-change-me
ADMIN_TOKEN_HOURS=8

# Integração com a iniciadora (URL/usuário/senha) e dados do recebedor do PIX:
# NÃO ficam mais aqui — são configurados no admin (aba "Integração"),
# em tempo de execução. Enquanto não configurados, o pagamento por Open
# Finance fica indisponível para o cliente.

# Segredo que assina o token de sessão do cliente (login com e-mail/senha).
# Gere um próprio em produção (mesmo comando do ADMIN_SECRET).
CUSTOMER_SECRET=dev-insecure-customer-secret-change-me

# --- Integração com o omnicommerce ---
# URL completa do webhook dele, com o segredo no caminho. Vazia DESLIGA o
# envio: o aviso nem é enfileirado e a loja segue funcionando normalmente.
OMNICOMMERCE_WEBHOOK_URL=https://omnicommerce.vercel.app/api/webhooks/sebo/SEGREDO
# Token que o omnicommerce apresenta para ler GET /integration/orders/{id}.
# Vazio recusa toda leitura. Gere um próprio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTEGRATION_TOKEN=
# Identifica esta loja no aviso. Precisa ser idêntico ao externalAccountId da
# conexão cadastrada no omnicommerce.
STORE_ID=sebo_online
# Tentativas de entrega antes de marcar o aviso como falho.
NOTIFICATION_MAX_ATTEMPTS=8
